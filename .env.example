# Copy to .env and fill in your own values. Never commit .env.

# Odoo (XML-RPC). With two-factor authentication on, use an API key as the password.
ODOO_URL=https://your-odoo.example.com
ODOO_DB=your_database
ODOO_USER=bot-user@example.com
ODOO_PASSWORD=your-odoo-api-key

# WhatsApp Cloud API (Meta)
WA_TOKEN=your-permanent-access-token
WA_PHONE_ID=your-phone-number-id
WA_VERIFY_TOKEN=any-random-string-you-choose
# Enables verification of the X-Hub-Signature-256 header (strongly recommended)
WA_APP_SECRET=your-meta-app-secret

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# WhatsApp numbers allowed to use the bot: comma-separated, country code, no "+".
# If empty, the bot ignores everyone.
ALLOWED_NUMBERS=57XXXXXXXXXX,57YYYYYYYYYY

# odoo   = validate Odoo deliveries (stock movements appear in the history)
# simple = legacy behaviour (default if the variable is missing)
MODO_ENTREGA=odoo
